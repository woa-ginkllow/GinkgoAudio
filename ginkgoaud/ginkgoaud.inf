; ginkgoaud.inf - miniport de audio PortCls (WaveRT) del altavoz interno.
;
; Hardware ID: ACPI\GNKAUD01  (dispositivo AUD1 de ginkgoaud_acpi.asl)
; Reproduce a traves de adspdrv.sys, que tiene que estar instalado.

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 10/28/2026,1.0.0.0
CatalogFile = ginkgoaud.cat
PnpLockdown = 1

[DestinationDirs]
GKA.CopyList = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
ginkgoaud.sys = 1

[Manufacturer]
%ProviderName% = GKA_Models,NTarm64

[GKA_Models.NTarm64]
%GKA.DeviceDesc% = GKA_Install, ACPI\GNKAUD01

[GKA.CopyList]
ginkgoaud.sys

[GKA_Install.NT]
Include  = ks.inf, wdmaudio.inf
Needs    = KS.Registration, WDMAUDIO.Registration
CopyFiles = GKA.CopyList
AddReg   = GKA.AddReg

[GKA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,ginkgoaud.sys

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%GKA.DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%GKA.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%GKA.DeviceDesc%

; Los nombres tienen que coincidir con PcRegisterSubdevice en adapter.cpp
[GKA_Install.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveSpeaker%,     GKA.I.WaveSpeaker
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveSpeaker%,     GKA.I.WaveSpeaker
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%,     GKA.I.WaveSpeaker
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologySpeaker%, GKA.I.TopologySpeaker
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, GKA.I.TopologySpeaker

[GKA.I.WaveSpeaker]
AddReg = GKA.I.WaveSpeaker.AddReg

[GKA.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%GKA.WaveSpeaker.szPname%

[GKA.I.TopologySpeaker]
AddReg = GKA.I.TopologySpeaker.AddReg

[GKA.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%GKA.TopologySpeaker.szPname%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

[GKA_Install.NT.Services]
AddService = ginkgoaud, 0x00000002, GKA_Service_Inst

[GKA_Service_Inst]
DisplayName   = %GKA.ServiceDesc%
ServiceType   = 1                  ; SERVICE_KERNEL_DRIVER
StartType     = 3                  ; SERVICE_DEMAND_START
ErrorControl  = 1
ServiceBinary = %12%\ginkgoaud.sys

[Strings]
ProviderName    = "woa-ginkllow"
DiskName        = "Ginkgo audio driver disk"
GKA.DeviceDesc  = "Audio del Redmi Note 8 (altavoz)"
GKA.ServiceDesc = "Ginkgo audio miniport"
GKA.WaveSpeaker.szPname     = "Altavoz del Redmi Note 8"
GKA.TopologySpeaker.szPname = "Altavoz del Redmi Note 8 Topologia"

KSNAME_WaveSpeaker     = "WaveSpeaker"
KSNAME_TopologySpeaker = "TopologySpeaker"

Proxy.CLSID        = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO    = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER   = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY      = "{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
